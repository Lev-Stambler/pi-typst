{
  "name": "pi-typst",
  "version": "0.3.0",
  "description": "Typst for pi: PDF-first CLI tools, a live browser preview, and explain/illustrate skills for CeTZ diagrams",
  "keywords": [
    "pi-package",
    "typst",
    "cetz",
    "diagrams",
    "preview",
    "typst.ts",
    "pdf",
    "wasm"
  ],
  "license": "MIT",
  "author": "Lev Stambler",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lev-Stambler/pi-typst.git"
  },
  "homepage": "https://github.com/Lev-Stambler/pi-typst#readme",
  "bugs": "https://github.com/Lev-Stambler/pi-typst/issues",
  "files": [
    "extensions",
    "skills",
    "prompts",
    "examples",
    "media",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "image": "https://raw.githubusercontent.com/Lev-Stambler/pi-typst/main/media/transformer-block.png"
  },
  "dependencies": {
    "@myriaddreamin/typst.ts": "0.8.0-rc3",
    "@myriaddreamin/typst-ts-renderer": "0.8.0-rc3",
    "@myriaddreamin/typst-ts-web-compiler": "0.8.0-rc3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^22.10.0",
    "typebox": "^1.3.7",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "selftest": "node scripts/selftest.ts",
    "selftest:browser": "node scripts/selftest.ts --browser"
  },
  "engines": {
    "node": ">=22.18"
  }
}
